# HamppServer Installation Script
# Author: Md Habibur Rahman
# Version: 2.0.0 - Simplified for beginners

echo "🚀 Installing HamppServer..."
echo ""

# Function to install packages on Termux
install_termux() {
    echo "📱 Detected Termux environment"

    # Update package list
    echo "📦 Updating package list..."
    pkg update -y

    # Install required packages
    echo "⚙️ Installing server components..."
    pkg install python -y
    pkg install apache2 -y
    pkg install mariadb -y
    pkg install php -y
    pkg install php-apache -y
    pkg install unzip -y
    pkg install wget -y
    
    # Setup storage permission for /sdcard access
    echo "📱 Setting up storage permissions..."
    if [ ! -d "/sdcard" ] || [ ! -w "/sdcard" ]; then
        echo "🔑 Please grant storage permission to Termux"
        termux-setup-storage
        sleep 2
    fi
    
    # Install Python dependencies
    echo "🐍 Installing Python dependencies..."
    pip install click rich pyyaml jinja2 psutil requests
}

# Function to install packages on Ubuntu/Debian
install_ubuntu() {
    echo "🐧 Detected Ubuntu/Debian environment"
    
    # Update package list
    echo "📦 Updating package list..."
    sudo apt update
    
    # Install required packages
    echo "⚙️ Installing server components..."
    sudo apt install -y python3 python3-pip
    sudo apt install -y apache2
    sudo apt install -y mysql-server
    sudo apt install -y php libapache2-mod-php php-mysql
    sudo apt install -y unzip wget
    
    # Install Python dependencies
    echo "🐍 Installing Python dependencies..."
    pip3 install click rich pyyaml jinja2 psutil requests
}

# Detect platform and install accordingly
if [ -d "/data/data/com.termux" ]; then
    install_termux
elif [ -f "/etc/debian_version" ] || [ -f "/etc/ubuntu-release" ]; then
    install_ubuntu
else
    echo "⚠️ Platform detection failed. Please install manually:"
    echo "  - Python 3"
    echo "  - Apache2"
    echo "  - MySQL/MariaDB"
    echo "  - PHP"
    echo "  - Python packages: pip install click rich pyyaml jinja2 psutil requests"
fi

# Create hampp command script
echo "🔧 Setting up hampp command..."

# Determine the bin directory based on platform
if [ -d "/data/data/com.termux" ]; then
    BIN_DIR="/data/data/com.termux/files/usr/bin"
    HAMPP_DIR="$(pwd)"
else
    BIN_DIR="/usr/local/bin"
    HAMPP_DIR="$(pwd)"
    
    # Check if we can write to /usr/local/bin
    if [ ! -w "$BIN_DIR" ]; then
        echo "⚠️ Cannot write to $BIN_DIR, creating local hampp command instead"
        BIN_DIR="$HOME/.local/bin"
        mkdir -p "$BIN_DIR"
        
        # Add to PATH if not already there
        if [[ ":$PATH:" != *":$BIN_DIR:"* ]]; then
            echo "💡 Add this to your ~/.bashrc or ~/.zshrc:"
            echo "   export PATH=\"\$HOME/.local/bin:\$PATH\""
        fi
    fi
fi

# Create the hampp command script
cat > "$BIN_DIR/hampp" << EOF
#!/bin/bash
# HamppServer Command
cd "$HAMPP_DIR"
if command -v python3 &> /dev/null; then
    exec python3 hampp.py "\$@"
else
    exec python hampp.py "\$@"
fi
EOF

# Make it executable
chmod +x "$BIN_DIR/hampp"

# Run the setup
echo "🔧 Running HamppServer setup..."
python3 hampp.py install

echo ""
echo "🎉 Installation complete!"
echo ""
echo "📖 Usage:"
echo "  hampp                     # Start HamppServer (interactive mode)"
echo "  hampp status              # Check server status"
echo "  python3 hampp.py --help  # See all options"
echo ""
echo "🌐 Once Apache is running, visit: http://localhost:8080"
echo ""

# Test if hampp command works
if command -v hampp &> /dev/null; then
    echo "✅ 'hampp' command is ready to use!"
else
    echo "⚠️ 'hampp' command not found in PATH. You can still use:"
    echo "   python3 hampp.py"
    echo "   or"
    echo "   ./hampp.sh"
fi
echo ""
