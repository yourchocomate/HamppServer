#!/bin/bash
# HamppServer Uninstallation Script
# Author: Md Habibur Rahman
# Version: 2.0.0

echo "🗑️ HamppServer Uninstaller"
echo "=========================="
echo ""

# Function to ask for confirmation
confirm_uninstall() {
    echo "⚠️ This will remove HamppServer and all its components."
    echo ""
    read -p "Are you sure you want to continue? (y/N): " confirm
    case $confirm in
        [Yy]* ) return 0;;
        * ) echo "Uninstall cancelled."; exit 0;;
    esac
}

# Function to stop all services
stop_services() {
    echo "🛑 Stopping HamppServer services..."
    
    # Try to stop using HamppServer if available
    if [ -f "hampp.py" ]; then
        python3 hampp.py stop-apache 2>/dev/null || true
        python3 hampp.py stop-mysql 2>/dev/null || true
    fi
    
    # Force stop services if still running
    if command -v pkill &> /dev/null; then
        pkill -f "apache" 2>/dev/null || true
        pkill -f "httpd" 2>/dev/null || true
        pkill -f "mysql" 2>/dev/null || true
        pkill -f "mysqld" 2>/dev/null || true
    fi
    
    echo "✅ Services stopped"
}

# Function to remove hampp command
remove_hampp_command() {
    echo "🗂️ Removing hampp command..."
    
    # Common binary locations
    HAMPP_LOCATIONS=(
        "/data/data/com.termux/files/usr/bin/hampp"
        "/usr/local/bin/hampp"
        "$HOME/.local/bin/hampp"
        "/usr/bin/hampp"
    )
    
    for location in "${HAMPP_LOCATIONS[@]}"; do
        if [ -f "$location" ]; then
            if [ -w "$(dirname "$location")" ]; then
                rm -f "$location"
                echo "✅ Removed $location"
            else
                echo "⚠️ Cannot remove $location (permission denied)"
                echo "   Please run: sudo rm -f $location"
            fi
        fi
    done
}

# Function to remove configuration files
remove_config() {
    echo "📁 Removing configuration files..."
    
    # Configuration directories
    CONFIG_DIRS=(
        "$HOME/.config/hampp"
        "/data/data/com.termux/files/home/.config/hampp"
    )
    
    for config_dir in "${CONFIG_DIRS[@]}"; do
        if [ -d "$config_dir" ]; then
            rm -rf "$config_dir"
            echo "✅ Removed configuration: $config_dir"
        fi
    done
}

# Function to remove log files
remove_logs() {
    echo "📄 Removing log files..."
    
    # Log directories
    LOG_DIRS=(
        "/var/log/hampp"
        "/data/data/com.termux/files/usr/var/log/hampp"
        "$HOME/.local/share/hampp"
    )
    
    for log_dir in "${LOG_DIRS[@]}"; do
        if [ -d "$log_dir" ]; then
            rm -rf "$log_dir"
            echo "✅ Removed logs: $log_dir"
        fi
    done
}

# Function to remove PID files
remove_pid_files() {
    echo "🔢 Removing PID files..."
    
    # PID file locations
    PID_FILES=(
        "/data/data/com.termux/files/usr/var/run/apache2/httpd.pid"
        "/var/run/apache2/httpd.pid"
        "/data/data/com.termux/files/usr/var/run/mysqld.pid"
        "/var/run/mysqld.pid"
    )
    
    for pid_file in "${PID_FILES[@]}"; do
        if [ -f "$pid_file" ]; then
            rm -f "$pid_file" 2>/dev/null || true
            echo "✅ Removed PID file: $pid_file"
        fi
    done
}

# Function to clean up temporary files
cleanup_temp() {
    echo "🧹 Cleaning up temporary files..."
    
    # Clean Python cache
    find . -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true
    find . -name "*.pyc" -delete 2>/dev/null || true
    
    # Clean backup files
    find . -name "*.bak" -delete 2>/dev/null || true
    find . -name "*~" -delete 2>/dev/null || true
    
    echo "✅ Temporary files cleaned"
}

# Function to show what will be kept
show_preserved() {
    echo ""
    echo "📂 The following will be PRESERVED:"
    
    # Check for web files
    WEB_DIRS=(
        "/sdcard/www"
        "$HOME/www"
        "/var/www/html"
    )
    
    for web_dir in "${WEB_DIRS[@]}"; do
        if [ -d "$web_dir" ]; then
            echo "   📁 Web files: $web_dir"
        fi
    done
    
    # Check for database files
    DB_DIRS=(
        "/data/data/com.termux/files/usr/var/lib/mysql"
        "/var/lib/mysql"
    )
    
    for db_dir in "${DB_DIRS[@]}"; do
        if [ -d "$db_dir" ]; then
            echo "   🗄️ Database files: $db_dir"
        fi
    done
    
    echo "   ⚙️ System packages (Apache, MySQL, PHP)"
    echo ""
}

# Function to show manual cleanup steps
show_manual_steps() {
    echo "📋 Manual cleanup (if desired):"
    echo ""
    
    if [ -d "/data/data/com.termux" ]; then
        # Termux instructions
        echo "To remove packages in Termux:"
        echo "   pkg uninstall apache2 mariadb php"
        echo ""
        echo "To remove Python packages:"
        echo "   pip uninstall click rich pyyaml jinja2 psutil requests"
    else
        # Linux instructions
        echo "To remove packages on Ubuntu/Debian:"
        echo "   sudo apt remove apache2 mysql-server php"
        echo ""
        echo "To remove Python packages:"
        echo "   pip3 uninstall click rich pyyaml jinja2 psutil requests"
    fi
    
    echo ""
    echo "To remove web files:"
    echo "   rm -rf /sdcard/www"
    echo "   # or rm -rf ~/www"
    echo ""
}

# Main uninstall process
main() {
    confirm_uninstall
    
    echo ""
    echo "🚀 Starting uninstallation..."
    echo ""
    
    stop_services
    echo ""
    
    remove_hampp_command
    echo ""
    
    remove_config
    echo ""
    
    remove_logs
    echo ""
    
    remove_pid_files
    echo ""
    
    cleanup_temp
    echo ""
    
    show_preserved
    
    echo "✅ HamppServer has been uninstalled successfully!"
    echo ""
    echo "📁 This HamppServer directory can now be safely deleted:"
    echo "   cd .."
    echo "   rm -rf HamppServer"
    echo ""
    
    show_manual_steps
    
    echo "👋 Thank you for using HamppServer!"
}

# Check if running from correct directory
if [ ! -f "hampp.py" ] && [ ! -f "install" ]; then
    echo "❌ Error: Please run this script from the HamppServer directory"
    echo "Expected files: hampp.py, install"
    exit 1
fi

# Run main uninstall
main
